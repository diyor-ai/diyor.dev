  linkedin: { vb: '0 0 24 24', d: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4z' },
} as const;
const stroke = {
  mail: 'M3 6h18v12H3zM3 7l9 7 9-7',
  wechat: 'M9 4C5.1 4 2 6.6 2 9.8c0 1.8 1 3.4 2.6 4.4L4 16.5l2.5-1.3c.8.2 1.600.3 2.500.3M22 14.200c0-2.800-2.700-5-6-5s-6 2.200-6 5 2.700 5 6 5c.7 0 1.400-.1 2-.3l2.200 1.100-.5-2c1.400-.9 2.300-2.300 2.300-3.800z',
  briefcase: 'M3 8h18v11H3zM9 8V5h6v3M3 13h18',
  download: 'M12 4v11m0 0l-4-4m4 4l4-4M5 20h14',
  rss: 'M5 5a14 14 0 0 1 14 14M5 11a8 8 0 0 1 8 8M6 19h.01',
  copy: 'M9 9h10v11H9zM5 15V4h10',
  arrow: 'M5 12h14m0 0l-5-5m5 5l-5 5',
} as const;
const f = (fill as any)[name];
---
{f
  ? <svg class="icon" viewBox={f.vb} width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d={f.d} /></svg>
  : <svg class="icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={(stroke as any)[name]} /></svg>}
