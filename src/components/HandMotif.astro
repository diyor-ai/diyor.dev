---
// MediaPipe hand-landmark topology: wrist 0; thumb 1-4; index 5-8; middle 9-12; ring 13-16; pinky 17-20.
const p: [number, number][] = [
  [200, 392],
  [152, 350], [112, 316], [84, 276], [62, 238],
  [150, 262], [137, 196], [129, 150], [123, 112],
  [196, 248], [199, 170], [200, 120], [201, 76],
  [242, 258], [254, 190], [261, 146], [266, 108],
  [280, 284], [304, 228], [316, 192], [326, 160],
];
const e: [number, number][] = [
  [0, 1], [1, 2], [2, 3], [3, 4],
  [0, 5], [5, 6], [6, 7], [7, 8],
  [9, 10], [10, 11], [11, 12],
  [13, 14], [14, 15], [15, 16],
  [17, 18], [18, 19], [19, 20],
  [5, 9], [9, 13], [13, 17], [0, 17],
];
---
<svg class="motif" viewBox="30 40 330 380" aria-hidden="true" focusable="false">
  {e.map(([a, b]) => <line x1={p[a][0]} y1={p[a][1]} x2={p[b][0]} y2={p[b][1]} />)}
  {p.map(([x, y], i) => <circle cx={x} cy={y} r={i % 4 === 0 && i > 0 ? 5.5 : 4.5} style={`animation-delay:${(i * 0.37).toFixed(2)}s`} />)}
</svg>
