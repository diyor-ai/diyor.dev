---
import { points as p, edges as e } from '../lib/hand';
---
<svg class="motif" viewBox="30 40 330 380" aria-hidden="true" focusable="false">
  {e.map(([a, b]) => <line x1={p[a][0]} y1={p[a][1]} x2={p[b][0]} y2={p[b][1]} />)}
  {p.map(([x, y], i) => <circle cx={x} cy={y} r={i % 4 === 0 && i > 0 ? 5.5 : 4.5} style={`animation-delay:${(i * 0.37).toFixed(2)}s`} />)}
</svg>
