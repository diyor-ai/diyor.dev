---
import Base from '../layouts/Base.astro';
import { getT, localePath, locales } from '../i18n/utils';
const en = getT('en');
---
<Base lang="en" title={en.meta.notFoundTitle} description={en.notFound.text} path="/404.html" langs={['en']} rss={false}>
  <section class="wrap page narrow">
    {locales.map((l) => {
      const n = getT(l).notFound;
      return <div class="nf" lang={getT(l).htmlLang}><h1>404 · {n.title}</h1><p class="lead">{n.text} <a href={localePath(l, '/')}>{n.home}</a></p></div>;
    })}
  </section>
</Base>
