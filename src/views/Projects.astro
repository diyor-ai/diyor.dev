---
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { getT, type Lang } from '../i18n/utils';
import { getProjectsWithFallback } from '../lib/content';
import { repoUpdated, commitDate } from '../lib/github';
const { lang } = Astro.props as { lang: Lang };
const t = getT(lang);
const projects = await getProjectsWithFallback(lang);
const others = await Promise.all(t.projectsPage.otherItems.map(async (o) => ({ ...o, updated: await repoUpdated(o.repo) })));
---
<section class="wrap page">
  <h1>{t.projectsPage.title}</h1>
  <p class="lead">{t.projectsPage.intro}</p>
  <h2>{t.featured.title}</h2>
  <div class="cards">{projects.map((p) => <ProjectCard lang={lang} slug={p.slug} fb={p.fb} {...p.data} />)}</div>
  <h2 class="mt">{t.projectsPage.other}</h2>
  <ul class="rows">
    {others.map((o) => (
      <li class="row">
        <div><h3>{o.title}</h3><p class="muted">{o.summary}</p></div>
        <p class="row-meta"><span class="mono">{o.stats}</span>{o.updated && <time class="updated muted" datetime={o.updated}>{t.projectsPage.updated.replace('{x}', commitDate(o.updated))}</time>}<a href={o.repo} rel="noopener"><Icon name="github" /><span>{t.projectsPage.otherLink}</span></a></p>
      </li>
    ))}
  </ul>
</section>
