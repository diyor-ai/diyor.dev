---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { getT, localePath, type Lang } from '../i18n/utils';
import { getPosts } from '../lib/content';
const { lang } = Astro.props as { lang: Lang };
const t = getT(lang);
const posts = await getPosts(lang);
const fmt = new Intl.DateTimeFormat(t.htmlLang, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<section class="wrap page narrow">
  <h1>{t.blog.title}</h1>
  <p class="lead">{t.blog.intro} <a href={localePath(lang, '/rss.xml')}><Icon name="rss" />{t.blog.rss}</a></p>
  {posts.length === 0 && <p class="muted">{t.blog.empty}</p>}
  <ul class="posts">
    {posts.map((p) => (
      <li class="post-item">
        {p.data.cover && <Image src={p.data.cover} alt={p.data.coverAlt} widths={[320, 480]} sizes="(max-width: 600px) 100vw, 240px" class="post-thumb" />}
        <div>
          <p class="muted mono">{fmt.format(p.data.date)}</p>
          <h2><a href={localePath(lang, `/blog/${p.slug}/`)}>{p.data.title}</a></h2>
          <p class="muted">{p.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
