---
import '../styles/global.css';
import { getT, locales, hreflangOf, labelOf, localePath, sectionOf, type Lang } from '../i18n/utils';
import { SITE } from '../config';
interface Props { lang: Lang; title: string; description: string; path: string; langs?: Lang[]; jsonLd?: object; type?: string; rss?: boolean; ogPath?: string; noindex?: boolean }
const { lang, title, description, path, langs = [...locales], jsonLd, type = 'website', rss = true, ogPath = '/og.png', noindex = false } = Astro.props;
const t = getT(lang);
const fullTitle = path === '/' ? title : `${title} · diyor.dev`;
const url = SITE + localePath(lang, path);
const ogImage = SITE + ogPath;
const nav = [['projects', '/projects/'], ['experience', '/experience/'], ['blog', '/blog/'], ['contact', '/contact/']] as const;
// Switcher destination: same page when translated; otherwise that language's section index (home for the 404 page).
const switchHref = (l: Lang) => localePath(l, noindex ? '/' : langs.includes(l) ? path : sectionOf(path));
const isActive = (p: string) => path === p || (p !== '/' && path.startsWith(p));
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  {!noindex && <link rel="canonical" href={url} />}
  {!noindex && langs.map((l) => <link rel="alternate" hreflang={hreflangOf[l]} href={SITE + localePath(l, path)} />)}
  {!noindex && <link rel="alternate" hreflang="x-default" href={SITE + localePath('en', path)} />}
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="diyor.dev" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  {!noindex && <meta property="og:url" content={url} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={t.ogLocale} />
  {!noindex && langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={getT(l).ogLocale} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#0a0e13" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {rss && <link rel="alternate" type="application/rss+xml" title="diyor.dev" href={localePath(lang, '/rss.xml')} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <script is:inline>
    (function () {
      var d = document.documentElement, t = null;
      d.classList.add('js');
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      d.dataset.theme = t;
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site-header">
    <div class="wrap bar">
      <a class="logo" href={localePath(lang, '/')}>diyor.dev</a>
      <button id="menu-toggle" class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t.menu}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="m-open" d="M4 7h16M4 12h16M4 17h16" /><path class="m-close" d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <div id="site-nav" class="nav-panel">
        <nav aria-label={t.navLabel}>
          {nav.map(([k, p]) => <a href={localePath(lang, p)} aria-current={isActive(p) ? 'page' : undefined}>{t.nav[k]}</a>)}
        </nav>
        <div class="tools">
          <div class="lang" role="group" aria-label={t.langLabel}>
            {locales.map((l) => <a href={switchHref(l)} hreflang={hreflangOf[l]} lang={hreflangOf[l]} aria-current={l === lang ? 'true' : undefined}>{labelOf[l]}</a>)}
          </div>
          <button id="theme-toggle" class="icon-btn" type="button" aria-label={t.theme}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="wrap site-footer">{t.footer} · <a href={localePath(lang, '/now/')}>{t.now.title}</a></footer>
  <script>
    const root = document.documentElement;
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
    const btn = document.getElementById('menu-toggle');
    const setMenu = (open: boolean) => { btn?.setAttribute('aria-expanded', String(open)); root.toggleAttribute('data-menu', open); };
    btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
    document.querySelectorAll('#site-nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  </script>
</body>
</html>
